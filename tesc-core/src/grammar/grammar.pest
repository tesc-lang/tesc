WHITESPACE = _{ " " | "\n" | "\t" | "\r" }

alpha = _{ 'a'..'z' | 'A'..'Z' }
digit = _{ '0'..'9' }

ident = { alpha ~ (alpha | digit | "_")* }

string_literal = { "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

arguments = { "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }

input  = { "input" ~ arguments }
output = { "output" ~ arguments }

builtin = { input | output }

function_call = { ident ~ "(" ~ arguments? ~ ")" }

block = { "{" ~ statement* ~ expression? ~ "}" }

test = { "test" ~ ident ~ "(" ~ expression ~ ")" ~ statement }

expression = { builtin | function_call | string_literal | block }
statement  = { expression ~ ";" | block | test }

module = { SOI ~ statement* ~ EOI }
